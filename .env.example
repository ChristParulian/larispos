# Salin file ini menjadi `.env` lalu isi dari project Supabase Anda.
# Dashboard Supabase → Project Settings → API.
#
# VITE_SUPABASE_URL      = Project URL, contoh: https://abcdefghijklm.supabase.co
# VITE_SUPABASE_ANON_KEY = anon / publishable key (BOLEH ada di frontend, dibatasi RLS).
#
# JANGAN PERNAH memasukkan service_role key ke file ini, ke frontend,
# atau ke repo — kunci itu melewati RLS.
#
# Bila kedua variabel ini kosong, aplikasi tetap jalan dalam MODE DEMO
# (data lokal 12 produk seed, transaksi disimpan di browser saja).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
